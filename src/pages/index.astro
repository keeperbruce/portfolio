---
import Layout from '../layouts/Layouts.astro';
const base = import.meta.env.BASE_URL;

const photos = [
	{ id: 1, src: "/img/Foto_edit.png", title: "Cielo Notturno Da Campetto", tech: "Galaxy S23 — Expert RAW, ISO 600"},
  	{ id: 2, src: "/img/via_lattea.jpg", title: "La Via Lattea?", tech: "Galaxy S23 — Expert RAW"},
  	{ id: 3, src: "/img/Panchina_solitaria.jpg", title: "Panchina Solitaria",tech: "Galaxy S23 — Expert RAW"},
  	{ id: 4, src: "/img/Rotore_non_nullo.png", title: "Rotore Non nullo", tech: "Galaxy S23 — Expert RAW"},
  	{ id: 5, src: "/img/Sembra_un_sogno.jpg", title: "Sembra un sogno", tech: "Galaxy S23 — Expert RAW"},
  	{ id: 6, src: "/img/Stelle_In_Campagna_Polacca.jpg", title: "Stelle in Campagna Polacca", tech: "Galaxy S23 — Expert RAW"},
];
---

<Layout title="Photography Portfolio">
  <main class="portfolio-main">
    
    <!-- HEADER -->
    <header class="portfolio-header">
      <div class="brand">
        <h1>Keeperbruce</h1>
        <p>Selected Works</p>
      </div>
      
      <div class="view-controls">
        <button id="btn-gallery" class="active">Gallery</button>
        <span class="separator">/</span>
        <button id="btn-market">Marketplace</button>
      </div>
    </header>

    <!-- GRIGLIA FOTO -->
    <div id="portfolio-grid" class="view-gallery-mode">
      {photos.map((photo) => (
        <div class="photo-card">
          
          <div class="image-wrapper">
            <img src={`${base}${photo.src}`} alt={photo.title} loading="lazy" />
          </div>
          
          <div class="meta-container">
            <div class="meta-text">
              <h3>{photo.title}</h3>
              <p>{photo.tech}</p>
            </div>
            <span class="market-tag">{photo.price}</span>
          </div>
          
        </div>
      ))}
    </div>

  </main>
</Layout>

<!-- is:global forza Astro ad applicare questo CSS ovunque, rendendolo a prova di bomba -->
<style is:global>
  /* RESET DI BASE */
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  
  body {
    font-family: system-ui, -apple-system, sans-serif;
    background-color: #fafafa; /* Grigio chiarissimo, stile galleria d'arte */
    color: #18181b;
  }

  .portfolio-main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  /* ==========================================================================
     HEADER E BOTTONI
     ========================================================================== */
  .portfolio-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1px solid #e4e4e7;
    padding-bottom: 1.5rem;
    margin-bottom: 4rem;
  }

  .brand h1 {
    font-size: 1.2rem;
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .brand p {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #a1a1aa;
    margin-top: 0.25rem;
  }

  .view-controls {
    display: flex;
    gap: 1rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .view-controls button {
    background: none;
    border: none;
    cursor: pointer;
    color: #a1a1aa;
    padding-bottom: 0.25rem;
    transition: color 0.3s;
    font-family: inherit;
  }

  .view-controls button.active {
    color: #18181b;
    border-bottom: 1px solid #18181b; /* Sottolinea il bottone attivo */
  }

  .view-controls .separator {
    color: #d4d4d8;
  }

  /* ==========================================================================
     MODALITÀ 1: GALLERY
     ========================================================================== */
  .view-gallery-mode {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8rem;
  }

  .view-gallery-mode .photo-card {
    width: 100%;
    max-width: 650px; /* Limite alla larghezza della foto */
  }

  .view-gallery-mode .image-wrapper {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .view-gallery-mode img {
    max-width: 100%;
    max-height: 75vh; /* La foto non supera mai il 75% dell'altezza del monitor */
    object-fit: contain; /* Rispetta le proporzioni originali senza tagliare */
  }

  .view-gallery-mode .market-tag {
    display: none; /* Prezzo nascosto in gallery */
  }

  /* ==========================================================================
     MODALITÀ 2: MARKETPLACE
     ========================================================================== */
  .view-market-mode {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 3rem 2rem;
  }

  .view-market-mode .image-wrapper {
    width: 100%;
    aspect-ratio: 1 / 1; /* Taglio quadrato uniforme */
    overflow: hidden;
    background-color: #f4f4f5;
  }

  .view-market-mode img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* Taglia l'immagine per riempire il quadrato */
    transition: transform 0.5s ease;
  }

  .view-market-mode img:hover {
    transform: scale(1.03); /* Leggero zoom al passaggio del mouse */
  }

  .view-market-mode .market-tag {
    display: inline-block;
    background-color: #f4f4f5;
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
    font-family: monospace;
    border-radius: 4px;
    color: #18181b;
  }

  /* ==========================================================================
     TESTI E ANIMAZIONI
     ========================================================================== */
  .meta-container {
    margin-top: 1.2rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .meta-text h3 {
    font-size: 0.95rem;
    font-weight: 500;
  }

  .meta-text p {
    font-size: 0.8rem;
    color: #71717a;
    margin-top: 0.3rem;
  }

  /* Animazione di apparizione */
  .photo-card {
    opacity: 0;
    transform: translateY(40px);
    filter: blur(8px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out, filter 0.8s ease-out;
  }

  .photo-card.is-visible {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }
</style>

<script>
  // Logica che gestisce tutto nel browser
  const initPortfolio = () => {
    const grid = document.getElementById('portfolio-grid');
    const btnGallery = document.getElementById('btn-gallery');
    const btnMarket = document.getElementById('btn-market');
    const cards = document.querySelectorAll('.photo-card');

    if (!grid || !btnGallery || !btnMarket) return;

    // --- Switch Layout ---
    btnGallery.addEventListener('click', () => {
      grid.className = 'view-gallery-mode';
      btnGallery.classList.add('active');
      btnMarket.classList.remove('active');
    });

    btnMarket.addEventListener('click', () => {
      grid.className = 'view-market-mode';
      btnMarket.classList.add('active');
      btnGallery.classList.remove('active');
    });

    // --- Animazione Comparsa (Intersection Observer) ---
    const observerOptions = {
      root: null,
      rootMargin: '0px',
      threshold: 0.1
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    cards.forEach(card => observer.observe(card));
  };

  document.addEventListener('DOMContentLoaded', initPortfolio);
</script>