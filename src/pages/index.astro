---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layouts.astro';

const base = import.meta.env.BASE_URL;

// Legge automaticamente tutti i file Markdown nella cartella src/content/photos/
// e li ordina se vuoi usare una data, altrimenti li restituisce nell'ordine in cui li trova.
const allPhotos = await getCollection('photos');
---

<Layout title="Photography Portfolio">
  <main class="portfolio-main">
    
    <!-- HEADER -->
    <header class="portfolio-header">
      <div class="brand">
        <h1>Keeperbruce</h1>
        <p>Selected Works</p>
      </div>
      
      <div class="view-controls">
        <button id="btn-gallery" class="active">Gallery</button>
        <span class="separator">/</span>
        <button id="btn-market">Griglia</button>
      </div>
    </header>

    <!-- GRIGLIA FOTO -->
    <div id="portfolio-grid" class="view-gallery-mode">

    <!-- INSERISCI QUESTA RIGA: -->
      {allPhotos.length === 0 && <h2 style="color:red; margin-top: 50px;">ERRORE: Astro non trova nessun file in src/content/photos/</h2>}
      {allPhotos.map((photo) => (
        <a href={`${base}/photo/${photo.id}`} class="photo-card-link">
          <div class="photo-card">
            
            <div class="image-wrapper">
              <!-- Legge i dati dal frontmatter del file Markdown -->
              <img src={`${base}/${photo.data.src}`} alt={photo.data.title} loading="lazy" />
            </div>
            
            <div class="meta-container">
              <div class="meta-text">
                <h3>{photo.data.title}</h3>
                <p>{photo.data.tech}</p>
              </div>
            </div>
            
          </div>
        </a>
      ))}
    </div>

  </main>
</Layout>

<!-- is:global forza Astro ad applicare questo CSS ovunque, rendendolo a prova di bomba -->
<style is:global>
  /* RESET DI BASE */
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  
  body {
    font-family: system-ui, -apple-system, sans-serif;
    background-color: #fafafa; /* Grigio chiarissimo, stile galleria d'arte */
    color: #18181b;
  }

  .portfolio-main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  /* ==========================================================================
     HEADER E BOTTONI
     ========================================================================== */
  .portfolio-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1px solid #e4e4e7;
    padding-bottom: 1.5rem;
    margin-bottom: 4rem;
  }

  .brand h1 {
    font-size: 1.2rem;
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .brand p {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #a1a1aa;
    margin-top: 0.25rem;
  }

  .view-controls {
    display: flex;
    gap: 1rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .view-controls button {
    background: none;
    border: none;
    cursor: pointer;
    color: #a1a1aa;
    padding-bottom: 0.25rem;
    transition: color 0.3s;
    font-family: inherit;
  }

  .view-controls button.active {
    color: #18181b;
    border-bottom: 1px solid #18181b; /* Sottolinea il bottone attivo */
  }

  .view-controls .separator {
    color: #d4d4d8;
  }

  /* ==========================================================================
     MODALITÀ 1: GALLERY
     ========================================================================== */
  .view-gallery-mode {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8rem;
  }

  .view-gallery-mode .photo-card {
    width: 100%;
    max-width: 650px; /* Limite alla larghezza della foto */
  }

  .view-gallery-mode .image-wrapper {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .view-gallery-mode img {
    max-width: 100%;
    max-height: 75vh; /* La foto non supera mai il 75% dell'altezza del monitor */
    object-fit: contain; /* Rispetta le proporzioni originali senza tagliare */
  }

  .view-gallery-mode .market-tag {
    display: none; /* Prezzo nascosto in gallery */
  }

  .photo-card-link {
    text-decoration: none;
    color: inherit;
    display: block;
    width: 100%;
  }

  /* ==========================================================================
     MODALITÀ 2: MARKETPLACE
     ========================================================================== */
  .view-market-mode {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 3rem 2rem;
  }

  .view-market-mode .image-wrapper {
    width: 100%;
    aspect-ratio: 1 / 1; /* Taglio quadrato uniforme */
    overflow: hidden;
    background-color: #f4f4f5;
  }

  .view-market-mode img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* Taglia l'immagine per riempire il quadrato */
    transition: transform 0.5s ease;
  }

  .view-market-mode img:hover {
    transform: scale(1.03); /* Leggero zoom al passaggio del mouse */
  }

  .view-market-mode .market-tag {
    display: inline-block;
    background-color: #f4f4f5;
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
    font-family: monospace;
    border-radius: 4px;
    color: #18181b;
  }

  /* ==========================================================================
     TESTI E ANIMAZIONI
     ========================================================================== */
  .meta-container {
    margin-top: 1.2rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .meta-text h3 {
    font-size: 0.95rem;
    font-weight: 500;
  }

  .meta-text p {
    font-size: 0.8rem;
    color: #71717a;
    margin-top: 0.3rem;
  }

  /* Animazione di apparizione */
  .photo-card {
    opacity: 0;
    transform: translateY(40px);
    filter: blur(8px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out, filter 0.8s ease-out;
  }

  .photo-card.is-visible {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }
/* ==========================================================================
     LAYOUT A ZIG-ZAG DEFINITIVO
     ========================================================================== */
  @media (min-width: 900px) {
    /* 1. Allarghiamo il contenitore a tutto schermo (Evadiamo dal layout base) */
    .view-gallery-mode {
      display: flex !important;
      flex-direction: column;
      gap: 10rem;
      width: 100vw !important;
      position: relative;
      left: 50%;
      right: 50%;
      margin-left: -50vw !important;
      margin-right: -50vw !important;
      max-width: 100vw !important;
      padding: 0 8vw !important; /* Margine laterale per non toccare i bordi del Mac */
      box-sizing: border-box;
    }

    /* 2. Diciamo al link di prendere tutto lo schermo */
    .view-gallery-mode .photo-card-link {
      width: 100% !important;
      display: block !important;
    }

    /* 3. DISTRUGGIAMO LA GABBIA: La card deve allargarsi al 100% */
    .view-gallery-mode .photo-card {
      width: 100% !important;
      max-width: none !important; /* <-- Questo era il colpevole! */
      display: flex !important;
      align-items: center;
      justify-content: space-between;
      gap: 6rem;
      background: none !important;
      box-shadow: none !important;
      margin: 0 !important;
    }

    /* CARTE DISPARI (Foto a Sinistra) */
    .view-gallery-mode .photo-card-link:nth-child(odd) .photo-card {
      flex-direction: row !important;
    }

    /* CARTE PARI (Foto a Destra) */
    .view-gallery-mode .photo-card-link:nth-child(even) .photo-card {
      flex-direction: row-reverse !important;
      text-align: right;
    }

    /* 4. Assegniamo esattamente le larghezze per spingerle ai bordi opposti */
    .view-gallery-mode .image-wrapper {
      flex: 0 0 65% !important; /* L'immagine prende il 65% della larghezza */
      max-width: 65% !important;
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 20px 40px rgba(0,0,0,0.1);
      transition: transform 0.5s ease;
    }

    .view-gallery-mode .meta-container {
      flex: 0 0 30% !important; /* Il testo prende il restante 30% */
      max-width: 30% !important;
      padding: 0 !important;
    }

    /* Immagini e Testi */
    .view-gallery-mode .image-wrapper img {
      width: 100%;
      height: auto;
      display: block;
      object-fit: cover;
    }

    .view-gallery-mode .meta-text h3 {
      font-size: 2.5rem;
      font-weight: 300;
      margin-bottom: 1rem;
      color: #18181b;
      line-height: 1.2;
    }

    .view-gallery-mode .meta-text p {
      font-size: 1.15rem;
      color: #71717a;
      line-height: 1.6;
    }

    /* Effetto Hover */
    .view-gallery-mode .photo-card-link:hover .image-wrapper {
      transform: translateY(-8px);
      box-shadow: 0 30px 60px rgba(0,0,0,0.15);
    }
  }
  </style>

<script>
  // Logica che gestisce tutto nel browser
  const initPortfolio = () => {
    const grid = document.getElementById('portfolio-grid');
    const btnGallery = document.getElementById('btn-gallery');
    const btnMarket = document.getElementById('btn-market');
    const cards = document.querySelectorAll('.photo-card');

    if (!grid || !btnGallery || !btnMarket) return;

    // --- Switch Layout ---
    btnGallery.addEventListener('click', () => {
      grid.className = 'view-gallery-mode';
      btnGallery.classList.add('active');
      btnMarket.classList.remove('active');
    });

    btnMarket.addEventListener('click', () => {
      grid.className = 'view-market-mode';
      btnMarket.classList.add('active');
      btnGallery.classList.remove('active');
    });

    // --- Animazione Comparsa (Intersection Observer) ---
    const observerOptions = {
      root: null,
      rootMargin: '0px',
      threshold: 0.1
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    cards.forEach(card => observer.observe(card));
  };

  document.addEventListener('DOMContentLoaded', initPortfolio);
</script>